# --- Unity core (safe to ignore) ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
DerivedDataCache/

# Unity caches & DBs
*.opendb
*.VC.db
sysinfo.txt

# IL2CPP / Burst build artifacts (Unity 2021+ & Unity 6)
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/

# Addressables build output (keep settings, ignore generated content)
ServerData/
Assets/StreamingAssets/aa/

# --- IDE / tooling ---
# JetBrains Rider / IntelliJ
.idea/
# VS Code workspace settings (optional; remove if your team commits these)
.vscode/

# Visual Studio / MonoDevelop auto-generated files
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb

# Gradle / Android export noise
.gradle/
*.apk
*.aab

# Xcode export noise (iOS builds)
*.xcodeproj/
*.xcworkspace
*.xcuserstate
*.xcuserdata/

# Unity packages (exported)
*.unitypackage

# Recorder outputs (optional)
Recordings/

# --- IMPORTANT ---
# Do NOT ignore:
#   - Assets/** (including *.meta files)
#   - ProjectSettings/**
#   - Packages/manifest.json and Packages/packages-lock.json
# These should be committed so the project opens correctly on every machine.



#BF Specific
AllScripts.txt
